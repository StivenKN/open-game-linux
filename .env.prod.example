# Variables for compose.prod.yaml. On Coolify or Dokploy, set them in the panel instead of using this file.
# URL-safe, because the app's DATABASE_URL embeds it: `openssl rand -hex 32`.
POSTGRES_PASSWORD=
# better-auth signs session cookies with this: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# The public https origin. Sign-in accepts only this origin, and the detector command is built from it.
BETTER_AUTH_URL=https://opengame.example.com
# Optional extra origins allowed to sign in, comma-separated.
BETTER_AUTH_TRUSTED_ORIGINS=
# Optional. `off` stops the daily ProtonDB and AreWeAntiCheatYet imports; anything else, or nothing, keeps them on.
SCHEDULED_IMPORTS=
