{
  "name": "opengame-linux",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "vite preview",
    "generate-routes": "tsr generate",
    "test": "vitest run",
    "db:up": "docker compose up -d --wait db",
    "db:migrar": "node --env-file-if-exists=.env scripts/migrar.ts",
    "db:reset": "node --env-file-if-exists=.env scripts/migrar.ts --reset",
    "db:sembrar": "node --env-file-if-exists=.env scripts/sembrar.ts",
    "rol": "node --env-file-if-exists=.env scripts/rol.ts",
    "db:auth-sql": "node --env-file-if-exists=.env scripts/auth-sql.ts",
    "check": "tsr generate && tsc --noEmit && oxlint && vitest run && vite build && node scripts/sin-servidor-en-cliente.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.2",
    "@effect/sql-pg": "4.0.2",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-start": "1.168.61",
    "better-auth": "1.7.7",
    "effect": "4.0.2",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.2",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vite": "^8.0.0",
    "vitest": "5.0.3"
  }
}
