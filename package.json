{
  "name": "opengame-linux",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "generate-routes": "tsr generate",
    "test": "vitest run",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:reset": "node --env-file-if-exists=.env scripts/migrate.ts --reset",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "db:protondb": "node --env-file-if-exists=.env scripts/protondb.ts",
    "db:anticheat": "node --env-file-if-exists=.env scripts/anticheat.ts",
    "set-role": "node --env-file-if-exists=.env scripts/set-role.ts",
    "db:auth-sql": "node --env-file-if-exists=.env scripts/auth-sql.ts",
    "gpu:generate": "node scripts/generate-gpus.ts",
    "parity": "node scripts/parity/parity.ts",
    "check": "tsr generate && tsc --noEmit && oxlint && vitest run && vite build && node scripts/no-server-in-client.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.2",
    "@effect/sql-pg": "4.0.2",
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/onest": "^5.3.1",
    "@fontsource/unbounded": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-start": "1.169.2",
    "better-auth": "1.7.7",
    "effect": "4.0.2",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "satori": "^0.63.2"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.2",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "nitro": "3.0.260903-beta",
    "oxlint": "1.87.0",
    "playwright-core": "1.62.1",
    "typescript": "7.0.2",
    "vite": "^8.0.0",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.4.1"
}
